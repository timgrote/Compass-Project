# Compass Environment Configuration
# Copy this file to .env and customize for your environment
#
# IMPORTANT: Never commit .env to git (it may contain secrets)

# ==============================================================================
# USER & TIMEZONE SETTINGS
# ==============================================================================

# User ID and Group ID (run `id -u` and `id -g` on Linux/WSL)
PUID=1000
PGID=1000

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# ==============================================================================
# OBSIDIAN SETTINGS (Phase 1)
# ==============================================================================

# Obsidian Web UI ports
OBSIDIAN_PORT=3000          # HTTP access to Obsidian GUI
OBSIDIAN_PORT_HTTPS=3001    # HTTPS access (optional)

# Obsidian Local REST API port
# This will be configured after first-time setup in Obsidian plugin settings
API_PORT=27124

# API Key for Obsidian Local REST API
# Generated on first run - update after initial setup
# Find in: Obsidian Settings → Community Plugins → Local REST API
API_KEY=

# ==============================================================================
# n8n SETTINGS (Phase 2 - Not used yet)
# ==============================================================================

# n8n_PORT=5678
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=  # Generate secure password

# ==============================================================================
# DATABASE SETTINGS (Phase 2 - Not used yet)
# ==============================================================================

# POSTGRES_DB=n8n
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=  # Generate secure password

# ==============================================================================
# MCP SETTINGS (Phase 4 - Not used yet)
# ==============================================================================

# MCP_PORT=3000
# ANTHROPIC_API_KEY=  # For Claude integration (optional)

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
#
# - Generate strong passwords (use: openssl rand -base64 32)
# - Keep .env file permissions restricted (chmod 600 .env)
# - Never share API keys or passwords
# - Backup .env file securely (not in git)
#
# ==============================================================================
